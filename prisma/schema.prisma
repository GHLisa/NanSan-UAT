generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // （可選）若要讓 migration 走直連、執行期走 pooler，先在本機 .env 與
  // Vercel 環境變數都設好 DIRECT_URL，再取消下一行註解：
  // directUrl = env("DIRECT_URL")
}

model Region {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  caseNoCode  String?      @map("case_no_code") // 公證編號代號（區域代號段；台北 ""、台中 T、高雄 K）
  departments Department[]

  @@map("regions")
}

model Department {
  id            Int             @id @default(autoincrement())
  name          String
  code          String          @unique
  caseNoCode    String?         @map("case_no_code") // 公證編號代號（產生公證編號用的部門前綴；未設定時回退 code）
  regionId      Int
  region        Region          @relation(fields: [regionId], references: [id])
  employeeRoles EmployeeRole[]
  cases         Case[]
  dispatches    DispatchQueue[]

  @@map("departments")
}

model Employee {
  id             Int              @id @default(autoincrement())
  name           String
  username       String           @unique
  password       String
  isActive       Boolean          @default(true)
  email          String?
  loginFailCount Int              @default(0)
  lockedUntil    DateTime?
  mustChangePassword Boolean      @default(false) // 首次登入/重設後須強制改密
  roles        EmployeeRole[]
  assignments  CaseAssignment[]
  progressLogs CaseProgress[]
  notes        CaseNote[]
  logs         CaseLog[]

  reviewsSubmitted    CaseReview[] @relation("SubmittedBy")
  reviewsReviewed     CaseReview[] @relation("ReviewedBy")
  reviewsApproved     CaseReview[] @relation("ApprovedBy")
  reviewsMidApproved  CaseReview[] @relation("MidApprovedBy")
  reviewsReportIssued CaseReview[] @relation("ReportIssuedBy")

  dispatchesAssigned DispatchQueue[] @relation("AssignedBy")
  dispatchesPicked   DispatchQueue[] @relation("PickedBy")

  settlementSplits SettlementSplit[]
  feeTargets       FeeTarget[]
  feeTargetsSet    FeeTarget[]      @relation("SetBy")
  notifications    Notification[]

  @@map("employees")
}

model EmployeeRole {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  departmentId Int?
  role         String
  roleName     String
  teamGroup    String?
  isPrimary    Boolean     @default(true)
  employee     Employee    @relation(fields: [employeeId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@unique([employeeId, departmentId, role, teamGroup])
  @@map("employee_roles")
}

model InsuranceCompany {
  id         Int               @id @default(autoincrement())
  code       String            @unique
  name       String
  branch     String?           // 分行（FR-30，選填）
  cases      Case[]
  coInsurers CaseCoInsurer[]
  dispatches DispatchQueue[]
  feeRates   CompanyFeeRate[]
  fireRates  CompanyFireRate[]

  @@map("insurance_companies")
}

model BrokerCompany {
  id         Int             @id @default(autoincrement())
  name       String
  isActive   Boolean         @default(true)
  cases      Case[]
  dispatches DispatchQueue[]

  @@map("broker_companies")
}

model InsuranceType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  feeCategory String
  isActive    Boolean @default(true)

  @@map("insurance_types")
}

model IncidentLocation {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  @@map("incident_locations")
}

model IncidentCause {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  @@map("incident_causes")
}

model Case {
  id                    Int       @id @default(autoincrement())
  caseNumber            String    @unique
  departmentId          Int
  insuranceCompanyId    Int
  brokerCompanyId       Int?
  insuranceContact      String?
  policyNumber          String
  insuredName           String
  incidentLocation      String
  incidentDate          DateTime
  commissionDate        DateTime
  insuranceType         String
  incidentCause         String
  estimatedAmount       BigInt?
  coverageLimit         BigInt?
  deductible            BigInt?   @default(0)
  adjustmentAmount      BigInt?
  salvageValue          BigInt?
  finalAmount           BigInt?
  estimatedFee          Int?
  actualFee             Int?
  travelOtherExpense    Int?
  preliminaryReportDate DateTime?
  finalReportDate       DateTime?
  closeDate             DateTime?
  status                String    @default("未決")
  currentStage          String    @default("進件/建檔")
  contactFormStatus     String?
  contactReturnDate     DateTime?
  nasFolder             String?
  parkingStatus         String?
  isSpecialCase         Boolean   @default(false)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  dispatchEntryId       Int?      @unique

  department       Department       @relation(fields: [departmentId], references: [id])
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  brokerCompany    BrokerCompany?   @relation(fields: [brokerCompanyId], references: [id])
  coInsurers       CaseCoInsurer[]
  assignments      CaseAssignment[]
  progress         CaseProgress[]
  caseNotes        CaseNote[]
  logs             CaseLog[]
  reviews          CaseReview[]
  settlement       Settlement?
  dispatchEntry    DispatchQueue?   @relation(fields: [dispatchEntryId], references: [id])
  notifications    Notification[]

  @@index([departmentId, status])
  @@index([commissionDate])
  @@index([insuranceCompanyId])
  @@map("cases")
}

model CaseCoInsurer {
  id           Int               @id @default(autoincrement())
  caseId       Int
  companyId    Int?
  policyNumber String
  ratio        Float
  case         Case              @relation(fields: [caseId], references: [id])
  company      InsuranceCompany? @relation(fields: [companyId], references: [id])

  @@map("case_co_insurers")
}

model CaseAssignment {
  id                 Int      @id @default(autoincrement())
  caseId             Int
  employeeId         Int
  role               String
  contributionRatio  Float
  case               Case     @relation(fields: [caseId], references: [id])
  employee           Employee @relation(fields: [employeeId], references: [id])

  settlementSplits SettlementSplit[]

  @@index([caseId])
  @@index([employeeId])
  @@map("case_assignments")
}

model CaseProgress {
  id           Int      @id @default(autoincrement())
  caseId       Int
  stage        String
  progressDate DateTime
  description  String?
  createdBy    Int
  case         Case     @relation(fields: [caseId], references: [id])
  creator      Employee @relation(fields: [createdBy], references: [id])

  @@index([caseId])
  @@map("case_progress")
}

model CaseNote {
  id        Int      @id @default(autoincrement())
  caseId    Int
  createdBy Int
  noteDate  DateTime
  content   String
  case      Case     @relation(fields: [caseId], references: [id])
  creator   Employee @relation(fields: [createdBy], references: [id])

  @@map("case_notes")
}

model CaseLog {
  id         Int      @id @default(autoincrement())
  caseId     Int
  employeeId Int
  changedAt  DateTime @default(now())
  fieldName  String
  oldValue   String?
  newValue   String?
  logType    String   @default("edit")
  amount     Int?
  case       Case     @relation(fields: [caseId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([caseId])
  @@map("case_logs")
}

model CaseReview {
  id               Int       @id @default(autoincrement())
  caseId           Int
  documentType     String
  checkedDocuments String?
  submittedBy      Int
  submittedAt      DateTime  @default(now())
  submissionNotes  String?
  reviewerId       Int
  reviewStatus     String    @default("待複核")
  reviewRemarks    String?
  reviewedAt       DateTime?

  requiresVP     Boolean   @default(false)
  approverId     Int?
  approvalStatus String?
  approvalRemarks String?
  approvedAt     DateTime?

  requiresMidApproval Boolean   @default(false)
  midApproverId       Int?
  midApprovalStatus   String?
  midApprovalRemarks  String?
  midApprovedAt       DateTime?

  interimTypes  String?
  interimAmount Int?
  feeReversed   Boolean @default(false)

  // [2026/06/18] - Lisa - 方案1/2 送審生命週期終結：null=進行中 / 已重送 / 已放棄
  recordStatus   String?
  supersededById Int?

  // [2026/07/03] - Lisa - 出具報告：文件通過整個審核流程後，行政人員登錄實際出具日期；null=尚未出具
  reportIssuedAt DateTime?
  reportIssuedBy Int?

  case         Case      @relation(fields: [caseId], references: [id])
  submitter    Employee  @relation("SubmittedBy", fields: [submittedBy], references: [id])
  reviewer     Employee  @relation("ReviewedBy", fields: [reviewerId], references: [id])
  approver     Employee? @relation("ApprovedBy", fields: [approverId], references: [id])
  midApprover  Employee? @relation("MidApprovedBy", fields: [midApproverId], references: [id])
  reportIssuer Employee? @relation("ReportIssuedBy", fields: [reportIssuedBy], references: [id])

  @@index([caseId])
  @@index([reviewerId, reviewStatus])
  @@map("case_reviews")
}

model DispatchQueue {
  id                   Int      @id @default(autoincrement())
  sourceType           String
  sourceReference      String
  insuranceCompanyId   Int
  brokerCompanyId      Int?
  assignedDepartmentId Int
  assignmentNotes      String?
  status               String   @default("待取件")
  assignedBy           Int
  pickedBy             Int?
  createdAt            DateTime @default(now())
  draftData            String?

  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  brokerCompany      BrokerCompany?   @relation(fields: [brokerCompanyId], references: [id])
  assignedDepartment Department       @relation(fields: [assignedDepartmentId], references: [id])
  assigner           Employee         @relation("AssignedBy", fields: [assignedBy], references: [id])
  picker             Employee?        @relation("PickedBy", fields: [pickedBy], references: [id])
  case               Case?

  @@index([assignedDepartmentId, status])
  @@map("dispatch_queue")
}

model Settlement {
  id            Int               @id @default(autoincrement())
  caseId        Int               @unique
  reportDate    DateTime
  baseFee       Int
  travelExpense Int               @default(0)
  totalFee      Int
  remarks       String?
  case          Case              @relation(fields: [caseId], references: [id])
  splits        SettlementSplit[]

  @@map("settlements")
}

model SettlementSplit {
  id           Int             @id @default(autoincrement())
  settlementId Int
  employeeId   Int
  assignmentId Int?
  ratio        Float
  amount       Int
  settlement   Settlement      @relation(fields: [settlementId], references: [id])
  employee     Employee        @relation(fields: [employeeId], references: [id])
  assignment   CaseAssignment? @relation(fields: [assignmentId], references: [id])

  @@map("settlement_splits")
}

model Notification {
  id          Int       @id @default(autoincrement())
  type        String
  title       String
  message     String
  caseId      Int?
  targetRoles String
  // [2026/06/24] - Lisa - 指定收件人（員工層級觸達）。設定後不受角色+案件範圍限制，
  // 用於精準通知個別審核人（尤其跨部門「加簽審核」高雄工程部主管，case scope 框不到）；
  // 為 null 時沿用既有 targetRoles+案件範圍廣播。軟參照（不設 FK），僅供查詢過濾。
  targetEmployeeId Int?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  readById    Int?
  case        Case?     @relation(fields: [caseId], references: [id])
  readBy      Employee? @relation(fields: [readById], references: [id])

  @@index([targetEmployeeId])
  @@map("notifications")
}

// 發信稽核紀錄（每次 sendMail 嘗試皆寫入一筆，best-effort、不影響寄送）
// caseId / caseNumber 為去正規化欄位（不設 FK），確保紀錄即使案件變動仍保留當時快照
model MailLog {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  category     String   @default("other") // new_assignment / assignment_changed / review_submitted / review_cascade / review_rejected / other
  subject      String
  recipients   String                     // 實際或預定收件人，逗號分隔
  status       String                     // sent（已送出）/ skipped（略過）/ failed（失敗）
  sentCount    Int      @default(0)
  skippedCount Int      @default(0)
  caseId       Int?
  caseNumber   String?
  error        String?
  bodyHtml     String?                    // 信件 HTML 內文快照（供發信紀錄明細檢視；PostgreSQL String 對應 text，無長度上限）

  @@index([createdAt])
  @@map("mail_logs")
}

// 登入稽核紀錄（每次登入嘗試皆寫入一筆，best-effort、不影響登入流程）
// employeeId / username / name 為去正規化欄位（不設 FK），確保紀錄即使帳號變動仍保留當時快照
model LoginLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  employeeId Int?                          // 帳號存在時記錄其 id；帳號不存在則為 null
  username   String                        // 當時輸入的登入帳號
  name       String?                       // 員工姓名快照
  status     String                        // success（成功）/ fail（失敗）/ locked（鎖定中拒絕）
  reason     String?                       // 失敗 / 拒絕原因（密碼錯誤 / 帳號不存在或已停用 / 帳號鎖定中）
  ip         String?                       // 來源 IP（取 x-forwarded-for 首段）
  userAgent  String?                       // 瀏覽器 User-Agent

  @@index([createdAt])
  @@index([username])
  @@map("login_logs")
}

model FeeTarget {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  year            Int
  targetAmount    Int?
  targetCaseCount Int?
  setBy           Int
  setAt           DateTime
  employee        Employee @relation(fields: [employeeId], references: [id])
  setter          Employee @relation("SetBy", fields: [setBy], references: [id])

  @@unique([employeeId, year])
  @@map("fee_targets")
}

model CompanyFeeRate {
  id                   Int              @id @default(autoincrement())
  companyCode          String
  companyName          String
  insuranceType        String
  debitNoteType        String
  minFee               Int              @default(20000)
  rateBands            String
  subRate              String?
  // 費用補貼採 JSON 編碼字串（同 rateBands 模式）：
  // "0"=不給、"400"=固定金額、{"morning":..}=分時、{"taipei":..}=分地點、"null"=改不給、"\"文字\""=說明（相片費）
  mealExpense          String           @default("0")
  accommodationExpense String           @default("0")
  photoFee             String           @default("0")
  effectiveDate        DateTime
  insuranceCompany     InsuranceCompany @relation(fields: [companyCode], references: [code])

  @@unique([companyCode, effectiveDate])
  @@map("company_fee_rates")
}

model CompanyFireRate {
  id            Int              @id @default(autoincrement())
  companyCode   String
  companyName   String
  debitNoteType String
  minFee        Int              @default(20000)
  rateBands     String
  remarks       String?
  effectiveDate DateTime
  insuranceCompany InsuranceCompany @relation(fields: [companyCode], references: [code])

  @@unique([companyCode, effectiveDate])
  @@map("company_fire_rates")
}

model CaseNumberSeq {
  deptCode String @id
  nextSeq  Int    @default(1)

  @@map("case_number_seq")
}

// [2026/07/15] - Lisa - 即時信改批次：原「即時通知」事件先入此佇列，由 /api/cron/event-digest
// 於台北平日 08:00 / 16:00 依收件人彙整成單封信寄出並標記 sentAt，避免信件轟炸。
model MailEventQueue {
  id           Int       @id @default(autoincrement())
  eventType    String    // new_assignment / assignment_changed / review_submitted / review_cascade / review_rejected
  caseId       Int?
  caseNumber   String
  insuredName  String?
  documentType String?
  remarks      String?   // 文件退回原因
  recipient    String    // 收件人「姓名 <email>」，一事件對多收件人各一列
  createdAt    DateTime  @default(now())
  sentAt       DateTime? // null = 待寄；已彙整寄出後填入時間

  @@index([sentAt])
  @@map("mail_event_queue")
}

// [2026/07/15] - Lisa - 系統參數設定（key-value）：僅系統管理員可維護。
// 首筆參數 email_enabled（是否啟動寄信功能，Y/N，預設 Y）供 lib/email.ts 判斷寄信總開關。
model SystemSetting {
  key         String   @id                 // 參數代碼，如 email_enabled
  value       String                       // 參數值，如 Y / N
  label       String                       // 顯示名稱，如「是否啟動寄信功能」
  description String?                      // 說明（選填）
  updatedAt   DateTime @updatedAt
  updatedById Int?                         // 最後修改者（去正規化，不設 FK）

  @@map("system_settings")
}
