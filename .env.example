# 執行期連線：使用 Neon「pooled」字串（host 含 -pooler）。
# 區域請選新加坡 ap-southeast-1，與 Vercel sin1 同區以降低延遲。
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1"
# Prisma migration / db push 用：同一個 DB 的「直連」字串（host 去掉 -pooler，移除 pgbouncer 參數）
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
JWT_SECRET="your-jwt-secret-at-least-32-chars"
JWT_EXPIRES_IN="8h"
NEXT_PUBLIC_APP_NAME="南山公證案件管理系統"
NODE_ENV="development"

# ── 字串加解密（雙層金鑰；用於加密 SMTP_PASS 等敏感值）──────────────
# 首次設定：npm run encrypt -- --genkey 產生下列兩值（已用 Master 加密的 Data Key/IV）
# 設定後，SMTP_PASS 等欄位請存「密文」（npm run encrypt -- "明文" 取得）
SYS_KEY=""
SYS_IV=""

# ── Email 通知（立即發送，走 SMTP）───────────────────────────────────
# SMTP 主機；未設定時系統僅在 server log 記錄、不實際寄送（dev 友善）
SMTP_HOST=""
# 連接埠：465（SSL）或 587（STARTTLS），預設 587
SMTP_PORT="587"
# 是否走 SSL；留空則依 PORT 自動判斷（465→true，其餘→false）
SMTP_SECURE=""
# 登入帳號
SMTP_USER=""
# 密碼：已設定 SYS_KEY/SYS_IV 時存「密文」（npm run encrypt -- "密碼"）；未設定則存明文
# Gmail 等請使用「應用程式密碼」
SMTP_PASS=""
# 寄件者，例：南山公證案件管理系統 <noreply@yourdomain.com>；留空則用 SMTP_USER
MAIL_FROM="南山公證案件管理系統 <noreply@yourdomain.com>"
# 信件中「前往案件」連結的站台網址（例：https://web-site-beryl-nu.vercel.app）；留空則不顯示連結
NEXT_PUBLIC_APP_URL=""
